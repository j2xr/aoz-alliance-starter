LLM_FALLBACK_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
# Ollama API key (OLLAMA_API_KEYS in the Ollama docker-compose).
# Leave empty if Ollama is on loopback without auth.
OLLAMA_API_KEY=
OLLAMA_MODEL=moondream
OLLAMA_NUM_CTX=2048
# Limits the number of tokens generated per request. Expected responses are
# a short JSON; keeping this cap low prevents one row from hogging the CPU.
OLLAMA_NUM_PREDICT=256
# Optional control for "thinking" models. Models that don't support it
# (e.g. moondream) ignore this setting.
OLLAMA_THINK=false
# How long Ollama keeps the model in memory after a request.
# Without keep_alive, the model is unloaded after ~5 min of inactivity,
# causing a cold-load of several seconds on each call. Default: 30m.
# Formats: "30m", "1h", "-1" (indefinitely), "0" (unload immediately),
# or an integer (seconds). Override via OLLAMA_KEEP_ALIVE.
OLLAMA_KEEP_ALIVE=30m
# HTTP timeout (seconds) for each Ollama /api/generate call. Default 300 (5 min).
# A small vision model on CPU can need 60-120s per row; raise if you hit ReadTimeout.
OLLAMA_TIMEOUT_SECONDS=300
# Timeout dedicated to the player_stats path (a single full-image call, not per row).
# 90s is enough for a 2B model on CPU; beyond that the uvicorn worker
# blocks and the Discord bot eventually drops the connection.
OLLAMA_PLAYER_STATS_TIMEOUT_SECONDS=90
# Max width and height (px) of the image sent to the LLM for player_stats.
# A 720x1600 screenshot generates more vision patch tokens than a 4096
# context can absorb, which blocks Ollama until the timeout. 720x960 covers ~4 rows.
OLLAMA_PLAYER_STATS_MAX_WIDTH=720
OLLAMA_PLAYER_STATS_MAX_HEIGHT=960
# Stop calling Ollama after this many consecutive failures within a single
# image so the OCR request doesn't hang for minutes when the LLM is OOM/slow.
# Code default if unset: 2.
LLM_MAX_CONSECUTIVE_FAILURES=2
OCR_CONFIDENCE_THRESHOLD=0.75          # global threshold — fallback if a specific variable is unset
# names: structurally low confidence on some fonts, hence the value
# deliberately lower than the global threshold (code default if unset: 0.75,
# i.e. OCR_CONFIDENCE_THRESHOLD).
OCR_CONFIDENCE_THRESHOLD_NAME=0.35
# Code default if unset: INFO. debug is noisier but convenient for local dev.
LOG_LEVEL=debug
# Both optional: the dispatcher loads title aliases from
# at_event_types.title_aliases at startup (RLS reserves read access to the
# authenticated role, so the service_role key is required for this -- there
# is no SUPABASE_ANON_KEY here, the anon key is never read by this service).
# Leave both empty to silently fall back to the embedded static alias list.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SQLite path for the job store. Use /tmp/jobs.db locally if /data is not mounted.
JOBS_DB_PATH=/data/jobs.db
# Seconds a job may sit in "pending" before a background watchdog force-errors
# it (payload {"error": "timeout"}) so the bot stops polling forever instead of
# waiting out its own 30-min give-up. Default 900 (15 min) is comfortably above
# the documented worst legitimate case: 2 consecutive LLM fallback failures x
# OLLAMA_TIMEOUT_SECONDS (300s default) = 10 min.
JOB_TIMEOUT_SECONDS=900
# Caps how many Ollama /api/generate calls this service issues at once. Ollama
# itself has only one active vision-inference slot by default; without this,
# concurrent reprocess-channel jobs pile up requests that queue behind each
# other and blow through OLLAMA_TIMEOUT_SECONDS before ever being served.
# Raise this only if OLLAMA_NUM_PARALLEL is also raised on the Ollama server
# (outside this repo).
OLLAMA_MAX_CONCURRENT_REQUESTS=1

# Advanced / rarely overridden -- code defaults shown, left commented out.
# OCR_BACKEND=tesserocr                        # tesserocr (in-process) or pytesseract (subprocess rollback)
# OCR_TESS_POOL_SIZE=16                        # size of the tesserocr PyTessBaseAPI instance pool
# OCR_NAME_ASCII_FAST_PATH_ENABLED=true        # try a fast ASCII-only OCR pass before the full multilingual one
# OCR_NAME_ASCII_FAST_PATH_MIN_CONF=0.60       # confidence floor to accept the fast-path result
# OCR_FUZZY_TITLE_THRESHOLD=0.82               # similarity floor for matching a screenshot title to a known event type
# OCR_TAB_DETECT_MIN_DELTA=15.0                # contribution-ranking: min gray-level deviation to trust the detected Daily/Weekly/History tab; below this the capture is rejected as unreadable, not assumed weekly
